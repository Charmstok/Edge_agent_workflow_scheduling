{
  "schema_version": 1,
  "sampling_id": "arch-linux-document-tools-holdout-v2",
  "tools": ["image_preprocess", "ocr", "pdf_parse", "pdf_render"],
  "scales": ["small", "medium", "large"],
  "concurrency_levels": [1, 2],
  "cold_start_runs": 1,
  "warmup_runs_per_worker": 1,
  "measurement_repetitions_per_worker": 3,
  "timeout_sec": 120.0,
  "resource_sample_interval_sec": 0.05,
  "input_templates": {
    "image_preprocess": "workload_fixtures_v1/beta-{scale}.png",
    "ocr": "workload_fixtures_v1/beta-{scale}.png",
    "pdf_parse": "workload_fixtures_v1/beta-{scale}.pdf",
    "pdf_render": "workload_fixtures_v1/beta-{scale}.pdf"
  },
  "image_preprocess": {
    "operations": ["grayscale", "blur", "threshold", "edge_detect"],
    "operation_repeat": 2
  },
  "pdf_render": {"dpi": 150}
}
